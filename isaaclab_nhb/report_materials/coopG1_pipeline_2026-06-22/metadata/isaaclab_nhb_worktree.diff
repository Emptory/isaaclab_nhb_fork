+def asset_rel_quat(
+    env: ManagerBasedEnv,
+    target_asset_cfg: SceneEntityCfg,
+    reference_asset_cfg: SceneEntityCfg,
+) -> torch.Tensor:
+    """Target asset orientation relative to the reference asset frame."""
+    target = env.scene[target_asset_cfg.name]
