+# Per hand, all values are expressed in the torso frame. The flattened layout is:
+# force (2 x 3), position (2 x 3), quaternion (2 x 4), linear velocity (2 x 3), angular velocity (2 x 3).
+EE_TARGET_FORCE_SLICE = slice(0, 6)
+EE_TARGET_POSITION_SLICE = slice(6, 12)
+EE_TARGET_QUATERNION_SLICE = slice(12, 20)
+EE_TARGET_LINEAR_VELOCITY_SLICE = slice(20, 26)
+EE_TARGET_ANGULAR_VELOCITY_SLICE = slice(26, 32)
+EE_TARGET_COMMAND_DIM = 32
+
+
+class EndEffectorTargetCommand(CommandTerm):
+    """Two-hand force and SE(3) trajectory command supplied by an upper-level controller."""
+
+    def __init__(self, cfg, env: ManagerBasedRLEnv):
+        super().__init__(cfg, env)
+        self.ee_target_command = torch.zeros(self.num_envs, EE_TARGET_COMMAND_DIM, device=self.device)
+        self._external_override = torch.zeros(self.num_envs, dtype=torch.bool, device=self.device)
+
+    @property
+    def command(self) -> torch.Tensor:
+        return self.ee_target_command
+
+    def set_command(
+        self,
+        command: torch.Tensor,
+        env_ids: Sequence[int] | torch.Tensor | None = None,
+    ) -> None:
+        """Persistently override sampled commands, normally from the upper-level controller."""
+        if env_ids is None:
+            env_ids = torch.arange(self.num_envs, device=self.device)
+        else:
+            env_ids = torch.as_tensor(env_ids, device=self.device, dtype=torch.long)
+        command = torch.as_tensor(command, device=self.device, dtype=self.ee_target_command.dtype)
+        if command.ndim == 1:
+            command = command.unsqueeze(0)
+        expected_shape = (len(env_ids), EE_TARGET_COMMAND_DIM)
+        if command.shape != expected_shape:
+            raise ValueError(f"Expected end-effector command shape {expected_shape}, got {tuple(command.shape)}")
+        self.ee_target_command[env_ids] = command
+        self._external_override[env_ids] = True
+
+    def clear_command(self, env_ids: Sequence[int] | torch.Tensor | None = None) -> None:
+        """Return selected environments to randomized training commands."""
+        if env_ids is None:
+            env_ids = torch.arange(self.num_envs, device=self.device)
+        else:
+            env_ids = torch.as_tensor(env_ids, device=self.device, dtype=torch.long)
+        self._external_override[env_ids] = False
+        self._resample_command(env_ids)
+
+    def _update_metrics(self):
+        pass
+
+    def _update_command(self):
+        pass
+
+    def _resample_command(self, env_ids: Sequence[int]):
+        env_ids = torch.as_tensor(env_ids, device=self.device, dtype=torch.long)
+        env_ids = env_ids[~self._external_override[env_ids]]
+        if len(env_ids) == 0:
+            return
+
+        count = len(env_ids)
+        command = self.ee_target_command[env_ids]
+        nominal_force = torch.tensor(self.cfg.nominal_force, device=self.device).repeat(2)
+        force_noise = torch.empty(count, 6, device=self.device).uniform_(*self.cfg.force_delta_range)
+        command[:, EE_TARGET_FORCE_SLICE] = nominal_force + force_noise
+
+        nominal_position = torch.tensor(self.cfg.nominal_positions, device=self.device).reshape(1, 2, 3)
+        position_delta = torch.tensor(self.cfg.position_delta, device=self.device).reshape(1, 1, 3)
+        position_noise = 2.0 * torch.rand(count, 2, 3, device=self.device) - 1.0
+        command[:, EE_TARGET_POSITION_SLICE] = (nominal_position + position_noise * position_delta).reshape(count, 6)
+
+        roll = torch.empty(count, 2, device=self.device).uniform_(*self.cfg.roll_range)
+        pitch = torch.empty(count, 2, device=self.device).uniform_(*self.cfg.pitch_range)
+        yaw = torch.empty(count, 2, device=self.device).uniform_(*self.cfg.yaw_range)
+        command[:, EE_TARGET_QUATERNION_SLICE] = quat_from_euler_xyz(roll, pitch, yaw).reshape(count, 8)
+        command[:, EE_TARGET_LINEAR_VELOCITY_SLICE] = torch.empty(count, 6, device=self.device).uniform_(
+            *self.cfg.linear_velocity_range
+        )
+        command[:, EE_TARGET_ANGULAR_VELOCITY_SLICE] = torch.empty(count, 6, device=self.device).uniform_(
+            *self.cfg.angular_velocity_range
+        )
+
