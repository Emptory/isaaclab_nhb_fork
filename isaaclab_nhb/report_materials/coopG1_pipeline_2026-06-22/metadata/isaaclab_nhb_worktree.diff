+    ref_vel_w = reference.data.body_link_lin_vel_w[:, reference_asset_cfg.body_ids[0]]
+    ref_quat_w = reference.data.body_link_quat_w[:, reference_asset_cfg.body_ids[0]]
+    num_bodies = body_vel_w.shape[1]
+    rel_vel = math_utils.quat_apply_inverse(
+        ref_quat_w.unsqueeze(1).expand(-1, num_bodies, -1).reshape(-1, 4),
+        (body_vel_w - ref_vel_w.unsqueeze(1)).reshape(-1, 3),
+    ).reshape(env.num_envs, num_bodies, 3)
+    target = env.command_manager.get_command(command_name)[:, EE_TARGET_LINEAR_VELOCITY_SLICE].reshape(
+        env.num_envs, num_bodies, 3
+    )
+    return torch.exp(-torch.sum(torch.square(rel_vel - target), dim=(1, 2)) / std**2)
+
